          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', \"timestamp\") AS time,\n       avg(rul_predit) AS \"RUL moyen (cycles)\"\nFROM ${site}.predictions\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
          "datasource": {
